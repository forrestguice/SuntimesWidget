<?xml version="1.0" encoding="UTF-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="22dp" android:height="22dp" />
            <solid android:color="@color/holo_selected_item_background_dark" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item android:left="-4dp" android:right="-4dp">
        <shape android:shape="rectangle">
            <size android:width="22dp" android:height="22dp" />
            <stroke android:width="2dp" android:color="@color/holo_accent_dark" />
            <corners android:radius="0dp" />
        </shape>
    </item>
</layer-list>